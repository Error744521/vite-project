    "crypto-js": "^4.2.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.1",
    "html2canvas": "^1.4.1",
    "pinia": "^3.0.3",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "swiper": "^11.2.10",
    "vue": "^3.5.13",
    "vue-color": "^3.3.2",
    "vue-router": "^4.5.1",
    "vue3-seamless-scroll": "^3.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
