    "postcss": "^8.5.4",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.1",
    "terser": "^5.48.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.3.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-svg-icons": "^2.0.1",
