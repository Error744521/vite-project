{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:mock": "vite --mode mock",
    "build": "vite build --mode production",
    "build:test": "vite build --mode test",
    "lint": "eslint src --ext .js,.vue -f ./eslint-formatter.cjs",
    "lint:fix": "eslint src --ext .js,.vue --fix -f ./eslint-formatter.cjs",
    "format": "prettier --write src/**/*.{js,vue,css,html}",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@logicflow/core": "^2.1.3",
    "@logicflow/extension": "^2.1.5",
